{
  "name": "lora",
  "private": true,
  "version": "0.1.0",
  "description": "Lora web app — dev tooling za pokretanje servera i browser smoke test",
  "type": "module",
  "scripts": {
    "build": "cd engine && npm run build",
    "test": "cd engine && npm test",
    "serve": "node tools/serve.js",
    "test:ui": "node tools/browser-smoke-test.mjs",
    "test:online": "node tools/online-smoke-test.mjs",
    "test:server": "cd server && node test/rating.mjs && node test/e2e.mjs",
    "test:admin": "cd server && node test/admin.mjs",
    "deploy": "bash tools/deploy.sh",
    "indexnow": "node tools/notify-indexnow.mjs",
    "og-image": "node tools/og-image.mjs",
    "cards-webp": "node tools/cards-webp.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
