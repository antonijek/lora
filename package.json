{
  "name": "lora",
  "private": true,
  "version": "0.1.0",
  "description": "Lora web app — dev tooling za pokretanje servera i browser smoke test",
  "type": "module",
  "scripts": {
    "build": "cd engine && npm run build",
    "test": "cd engine && npm test",
    "serve": "node tools/serve.js",
    "test:ui": "node tools/browser-smoke-test.mjs",
    "test:online": "node tools/online-smoke-test.mjs",
    "test:server": "cd server && node test/e2e.mjs",
    "deploy": "bash tools/deploy.sh"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
